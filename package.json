{
    "name": "Neptune-Gremlin",
    "version": "0.2.17",
    "author": "hackolade",
    "engines": {
        "hackolade": "4.2.10",
        "hackoladePlugin": "1.0.0"
    },
    "contributes": {
        "target": {
            "applicationTarget": "Neptune-Gremlin",
            "title": "Neptune w/ Gremlin API",
            "versions": []
        },
        "features": {
            "jaySchemaHasRequiredPatternField": false,
            "nestedCollections": {
                "isVirtual": true,
                "hasMultipleParents": true
            },
            "enableComplexTypesNormalization": true,
            "requireComplexTypesNormalization": true,
            "graphDB": true,
            "relationships": {
                "connectOnEntityLevel": true,
                "hasData": true
            },
            "enableForwardEngineering": true,
            "enableReverseEngineering": true,
            "disableChoices": true,
            "disableMultipleTypes": true
        }
    },
    "description": "Hackolade plugin for Amazon Neptune with Gremlin API",
    "disabled": false,
    "simple-git-hooks": {
        "pre-commit": "npm run package && npx lint-staged --config lint-staged.config.js",
        "pre-push": "npm run lint"
    },
    "scripts": {
        "lint": "oxlint . || true",
        "package": "node esbuild.package.js",
        "install": "npx patch-package",
        "postinstall": "npx simple-git-hooks",
        "lint:check": "oxlint --type-aware --type-check . || true",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@hackolade/hck-esbuild-plugins-pack": "0.0.1",
        "@ianvs/prettier-plugin-sort-imports": "4.7.1",
        "esbuild": "0.28.2",
        "esbuild-node-externals": "1.23.1",
        "esbuild-plugin-clean": "1.0.1",
        "esbuild-plugin-copy": "2.1.1",
        "lint-staged": "17.6.0",
        "oxlint": "1.93.0",
        "oxlint-tsgolint": "7.0.2006",
        "prettier": "3.10.1",
        "simple-git-hooks": "2.14.0"
    },
    "dependencies": {
        "@aws-sdk/client-neptune": "3.1167.0",
        "@hackolade/fetch": "1.1.0",
        "async": "3.2.6",
        "gremlin": "3.7.3",
        "lodash": "4.18.1"
    },
    "overrides": {
        "minimatch": "11.0.8",
        "uuid": "14.0.0",
        "brace-expansion": "5.0.13"
    }
}
